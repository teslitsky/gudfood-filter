{
  "name": "gudfood-filter",
  "version": "1.0.0",
  "description": "GudFood Filter extension",
  "main": "index.js",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info  --import tsx src/**/*.spec.ts",
    "lint": "eslint --fix",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "pack": "node pack.js",
    "repack": "npm run build && npm run pack"
  },
  "keywords": [
    "chrome",
    "extension",
    "gudfood"
  ],
  "author": "Dmytro Teslitsky <dmitryteslitsky@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "0.1.18",
    "@types/jquery": "3.5.33",
    "@types/jqueryui": "1.12.24",
    "adm-zip": "0.5.16",
    "copy-webpack-plugin": "11.0.0",
    "eslint": "9.39.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-security": "1.7.1",
    "prettier": "3.6.2",
    "ts-loader": "9.5.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "webpack": "5.102.0",
    "webpack-cli": "5.1.4"
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true
  }
}
